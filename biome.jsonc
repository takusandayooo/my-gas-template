{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noShadowRestrictedNames": "off"
      },
      "complexity": {
        "noForEach": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "off"
      }
    }
  },
  "files": {
    "includes": ["**", "!**/build", "!**/node_modules", "!**/.pnpm-store"]
  }
}
