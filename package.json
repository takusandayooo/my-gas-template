{
  "name": "gas-template",
  "version": "1.0.0",
  "description": "",
  "main": "build/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "open:prod": "clasp_config_project=.clasp.prod.json clasp open",
    "open:dev": "clasp_config_project=.clasp.dev.json clasp open",
    "lint": "biome check",
    "lint-fix": "biome check --write",
    "type-check": "tsc --noEmit",
    "build": "bun build.js",
    "prepare": "husky",
    "prepush": "mkdir -p build && cp appsscript.json build/appsscript.json",
    "buildpush:prod": "bun run build && bun run prepush && clasp_config_project=.clasp.prod.json clasp push --force",
    "buildpush:dev": "bun run build && bun run prepush && clasp_config_project=.clasp.dev.json clasp push --force"
  },
  "dependencies": {
    "@biomejs/biome": "^2.4.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "devDependencies": {
    "@google/clasp": "^2.5.0",
    "@types/google-apps-script": "^1.0.100",
    "esbuild": "^0.25.12",
    "esbuild-gas-plugin": "^0.8.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts}": ["biome check --write"]
  },
  "packageManager": "bun@1.3.11"
}
